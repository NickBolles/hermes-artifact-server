{
  "name": "hermes-artifact-server",
  "version": "0.1.0",
  "description": "Small hardened Docker service for publishing browser-loadable Hermes artifacts.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "npm run build && node --test dist/**/*.test.js",
    "admin:bootstrap": "node dist/cli.js bootstrap-admin"
  },
  "dependencies": {
    "@fastify/busboy": "^3.2.0",
    "@node-rs/argon2": "^2.1.0",
    "@simplewebauthn/server": "^13.3.2",
    "compression": "^1.8.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "mime-types": "^3.0.1",
    "nanoid": "^5.1.6",
    "pino": "^9.7.0",
    "pino-http": "^10.5.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.3",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^24.9.1",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "overrides": {
    "ip-address": "10.5.0"
  }
}
