# Public HTTPS URL where the service is reachable, without trailing slash.
BASE_URL=https://artifacts.example.com
# Authenticated app/admin origin. Must be a different hostname from BASE_URL.
APP_ORIGIN=https://artifact-apps.example.com

# Required for publishing/write API operations. Use at least 32 random bytes.
API_TOKEN=change-me-long-random-api-token

# Optional compatibility credentials for the legacy /admin/files browser only.
# The new /admin console uses passkeys and local application sessions.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

ARTIFACT_ROOT=/data/artifacts
STATE_DB_PATH=/data/state/artifact-app.db
PORT=3000
# One reverse-proxy hop. Avoid unconditional true when the container port is directly reachable.
TRUST_PROXY=1
MAX_UPLOAD_BYTES=52428800

# Defaults derive from APP_ORIGIN. Keep both pinned to the exact authenticated app host.
WEBAUTHN_RP_ID=artifact-apps.example.com
WEBAUTHN_ORIGIN=https://artifact-apps.example.com

ACTION_LIMIT_PER_MINUTE=10
ACTION_LIMIT_PER_DAY=100
SESSION_IDLE_MINUTES=1440
RECOVERY_MAX_CONCURRENT=2
HERMES_RUN_MAX_MINUTES=30

# Optional private Hermes integrations. Keep these server-side only.
# Webhook requests use X-Webhook-Timestamp + X-Webhook-Signature-V2.
HERMES_WEBHOOK_URL=
HERMES_WEBHOOK_SECRET=

# For page-visible asynchronous /v1/runs. Prefer a private-network URL and restricted profile.
HERMES_API_URL=
HERMES_API_KEY=
