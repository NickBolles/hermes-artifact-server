# Public URL where the service is reachable, without trailing slash.
BASE_URL=https://artifacts.example.com

# Required for write/API operations. Use at least 32 random bytes.
API_TOKEN=change-me-long-random-api-token

# Required for /admin file browser. Use reverse proxy auth instead if preferred.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-long-random-admin-password

ARTIFACT_ROOT=/data/artifacts
PORT=3000
TRUST_PROXY=true
MAX_UPLOAD_BYTES=52428800
